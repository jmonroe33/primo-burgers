# ─── Required ────────────────────────────────────────────────────────────────
# Long random string used to sign logins. Generate with:  openssl rand -hex 32
PAYLOAD_SECRET=

# The permanent public address of the website (no trailing slash).
# This is what the printed QR code points to — set it to the real domain before printing.
NEXT_PUBLIC_SITE_URL=https://www.primoburgers.com

# Database. Local development uses a file; production uses Turso (hosted SQLite, free tier).
#   local:      file:./primo.db
#   production: libsql://<your-db>-<your-org>.turso.io
DATABASE_URL=file:./primo.db
# Only needed for Turso:  turso db tokens create <your-db>
DATABASE_AUTH_TOKEN=

# ─── Production photo storage (Vercel) ───────────────────────────────────────
# Created automatically when you add a Vercel Blob store to the project.
# Leave blank locally — photos are then saved to ./media.
BLOB_READ_WRITE_TOKEN=

# ─── Optional: local testing only ────────────────────────────────────────────
# If set, `npm run seed` also creates this Owner/Admin login. Never set these in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
